# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ──────────────────────────── 日志与可观测性 ────────────────────────────
# 日志与可观测性配置。改这里即可，不需要改代码。
#
# 注意：本文件是「样例」，服务**不会**自动读取 .env 的注释说明以外的魔法；
# 真正生效方式二选一 —— 复制为 .env（服务启动时会读），或直接设置环境变量。
# 已存在的真实环境变量优先级更高，.env 不会覆盖它。

# DY_LOG_DIR: 日志落盘目录
#   不设时默认 server/logs/（跟着项目走，换机器只要目录结构一样就自动对）。
#   设了就用它：绝对路径原样使用；**相对路径相对启动时的当前工作目录**，
#   所以写相对路径时请从项目根目录启动（npm run server / start-server.bat 都是）。
DY_LOG_DIR=""

# DY_LOG_LEVEL: 最低记录级别 debug | info | warn | error | fatal
#   默认 info。排查疑难问题时可临时调到 debug。
DY_LOG_LEVEL="info"

# DY_LOG_RETENTION_DAYS: ★ 应用日志保留天数（这就是「保留策略」开关）
#   默认 7（保留一周）。想改成 3 天就写 3，想改成 30 天就写 30。
#   清理在服务启动时执行一次，之后每 6 小时一次，无需手工删文件。
DY_LOG_RETENTION_DAYS="7"

# DY_LOG_ERROR_RETENTION_DAYS: 错误日志保留天数（错误证据留久一点）
#   默认 14。
DY_LOG_ERROR_RETENTION_DAYS="14"

# DY_LOG_CONSOLE: 是否同时打印到控制台 on | off（默认 on）
DY_LOG_CONSOLE="on"

# DY_LOG_SERVICE: 日志里的服务名，跨服务检索时用它区分来源
DY_LOG_SERVICE="dingyun-inventory"

# DY_LOG_VERSION: 日志里记录的服务版本，配合发布追溯
DY_LOG_VERSION="2.0.0"
